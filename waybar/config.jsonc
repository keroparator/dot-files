{
    // General Settings
    "mode": "dock",
    "layer": "top",
    "position": "top",
    "margin-left": 5,
    "margin-right": 5,
    "margin-top": 5,
    "spacing": 50,
    // Modules Layout
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "pulseaudio",
        "backlight",
        "bluetooth",
        "network",
        "battery"
    ],
    // Module Configurations
    "hyprland/workspaces": {},
    "clock": {
        "tooltip-format": "<big><tt>{calendar}</tt></big>",
        "format-alt": "{:%d-%m-%Y}"
    },
    "pulseaudio": {
        "width": 10,
        "format": "\uf028",
        "format-muted": "",
        "tooltip-format": "Playing at {volume}%",
        "scroll-step": 2,
        "on-click": "$TERMINAL --class=Wiremix -e wiremix",
        "on-click-right": "hyprctl dispatch exec [float] pavucontrol"
    },
    "backlight": {
        "format": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            ""
        ],
        "format-alt": "{percent}% {icon}",
        "format-icons": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            ""
        ],
        "on-click": "hyprsunset --temperature 2000",
        "on-click-right": "pkill hyprsunset"
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "",
        "format-connected": "",
        "tooltip-format": "Devices connected: {num_connections}"
    },
    "network": {
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "format-wifi": ""
    },
    "battery": {}
}